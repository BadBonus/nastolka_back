enum OrgFormatMode {
  HYBRID
  ONLINE
  OFFLINE
}

enum CostFormat {
  payment
  donate
}

model Org {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String   @unique @db.VarChar(256)
  nickname    String   @map("nickname")
  description String?
  previewDescr   String?  @map("preview_descr")
  gameStyleDescr String?  @map("game_style_descr")

  costValue    Int?       @map("cost_value")
  costCurrency Currency?  @map("cost_currency")
  costFormat   CostFormat @default(payment) @map("cost_format")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  avatar             String?             @map("avatar_url")
  timezone           String?             @default("UTC") @db.VarChar(100)
  soclinks           Json?
  gameHistory        Json                @default("[]")
  schedules          Json                @default("[]")
  email              String              @unique
  reviews           EventReview[]
  events            Event[]
  isBanned          Boolean             @default(false) @map("is_banned")

  preferredSystems GameSystem[]  @map("preferred_systems")
  preferredGenres  GameGenres[]  @map("preferred_genres")

  formatMode OrgFormatMode @default(HYBRID) @map("format_mode")
  countryId  Int           @map("country_id")
  country    Country       @relation(fields: [countryId], references: [geonameId])
  cityId     Int?          @map("city_id")
  city       City?         @relation(fields: [cityId], references: [geonameId])

  @@index([countryId])
  @@index([cityId])
  @@index([formatMode])
  @@map("orgs")
}
