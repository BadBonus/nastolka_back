enum EventStatus {
  PREPARE
  ACTIVE
  FINISHED
  CANCELED
}

enum RequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  WAITLIST
  CANCELED
}

model Event {
  id                 String         @id @default(uuid())
  slug               String         @unique @db.VarChar(256)
  
  orgId              String         @map("org_id")
  org                Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name               String
  description        String?        @db.Text
  synopsis           String?        @db.Text
  addInfo            String?        @map("add_info") @db.Text
  preview            String?        @map("preview_url")

  minUsers           Int            @default(1) @map("min_users")
  maxUsers           Int?           @map("max_users")
  
  isBeginnerFriendly Boolean        @default(true) @map("is_beginner_friendly")
  ageLimit           Int?           @map("age_limit")
  autoApprove        Boolean        @default(false) @map("auto_approve")

  costValue          Int?           @map("cost_value")
  costCurrency       Currency?      @map("cost_currency")

  format             EventFormat
  sessionType        SessionType    @map("session_type")

  /// ONLINE: { type, links[] } | OFFLINE: { type, address, lat, lng, mapUrl? }
  venue              Json

  showLocation       Boolean        @default(true) @map("show_location")
  showMaterials      Boolean        @default(true) @map("show_materials")

  status             EventStatus    @default(PREPARE)

  startsAt           DateTime       @map("starts_at")
  endsAt             DateTime       @map("ends_at")
  canceledAt         DateTime?      @map("canceled_at")
  cancelReason       String?        @map("cancel_reason")

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  requests           EventRequest[]
  reviews            EventReview[]
  favorites          EventFavorite[]
  materials          EventMaterial[]

  genres             GameGenres[]
  platforms          GamePlatform[]
  gameSystem         GameSystem     @map("game_system")

  @@index([slug])
  @@index([status, startsAt])
  @@map("events")
}

enum EventMaterialType {
  FILE
  NOTE
}

model EventMaterial {
  id           String            @id @default(uuid())
  eventId      String            @map("event_id")
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type         EventMaterialType
  title        String            @db.VarChar(120)
  sortOrder    Int               @default(0) @map("sort_order")
  isPublic     Boolean           @default(true) @map("is_public")

  storageKey   String?           @map("storage_key") @db.VarChar(512)
  originalName String?           @map("original_name") @db.VarChar(255)
  mimeType     String?           @map("mime_type") @db.VarChar(120)
  sizeBytes    Int?              @map("size_bytes")
  checksum     String?           @db.VarChar(64)

  body         String?           @db.Text

  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([eventId, sortOrder])
  @@map("event_materials")
}

model EventRequest {
  id         String        @id @default(uuid())
  eventId    String        @map("event_id")
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     RequestStatus @default(PENDING)
  message    String?       @db.Text
  isAttended Boolean       @default(false) @map("is_attended")

  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@map("event_requests")
}

enum KindOfRate {
  CREATIVITY
  STORYTELLING
  PLAYER_EDUCATION
  THEATRICALISE
}

model EventReview {
  id        String       @id @default(uuid())
  eventId   String       @map("event_id")
  event     Event        @relation(fields: [eventId], references: [id])
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id])
  orgId     String       @map("org_id")
  org       Org          @relation(fields: [orgId], references: [id])
  comment   String?
  rates     KindOfRate[]
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@map("event_reviews")
}