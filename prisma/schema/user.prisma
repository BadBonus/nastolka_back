model User {
  fullName           String?             @map("full_name")
  nickname           String
  email              String              @unique
  roles              Role[]
  description        String?
  birthdate          DateTime?
  slug               String              @unique @db.VarChar(256)
  avatar             String?             @map("avatar_url")
  timezone           String?             @default("UTC") @db.VarChar(100)
  isVerified         Boolean             @default(false) @map("is_verified")
  id                 String              @id @default(uuid())
  sub                Json                @default("{\"events\": [], \"gamemasters\": []}")
  soclinks           Json?
  gameHistory        Json                @default("[]")
  accounts           Account[]
  sessions           Session[]
  passwordResetToken PasswordResetToken?
  schedules          UserSchedule[]
  supportTickets     SupportTicket[]
  org                Org?
  reviews            EventReview[]
  eventRequests      EventRequest[]
  isBanned           Boolean             @default(false) @map("is_banned")

  @@map("users")
}

model UserSchedule {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int    @map("day_of_week")
  startTime Int    @map("start_time")
  endTime   Int    @map("end_time")

  @@map("user_schedules")
}

enum ESocLinks {
  VK
  TELEGRAM
  DISCORD
  INSTAGRAM
  X
  REDDIT
}
